# Settings for asciifishtv-tank.service. Every flag of `tank -help` can be set
# here as TANK_<FLAG_NAME>.

# Draw on the HDMI output and hide the console on tty1.
TANK_OUTPUT=fb
TANK_FB=/dev/fb0
TANK_TTY=/dev/tty1
# 54 rows at 1080p gives a font close to what xterm showed.
TANK_ROWS=54
TANK_FPS=20

# HTTP command API. Use a long random token: openssl rand -hex 24
TANK_LISTEN=:8080
TANK_TOKEN=change-me

# Music: every MP3 under this folder (subfolders included), shuffled, played with the same mplayer
# the Pi already uses (so the audio output it's set up for keeps working).
# mpg123 -q also works.
TANK_MUSIC_DIR=/home/attwoam/Music
TANK_PLAYER=mplayer -noconsolecontrols -really-quiet -nolirc
TANK_SONG_BANNER_EVERY=10m
TANK_SONG_BANNER_SECONDS=20

# Safety caps.
TANK_MAX_VIEWER_FISH=25
TANK_FISH_LIFETIME=15m
TANK_MAX_CREATURES=3
